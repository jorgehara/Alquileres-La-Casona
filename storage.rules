rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return request.auth.token.role;
    }

    function ownerScope() {
      return request.auth.token.ownerScope;
    }

    function tenantId() {
      return request.auth.token.tenantId;
    }

    function hasValidProjectedClaims() {
      return isSignedIn()
        && (
          userRole() == "superadmin"
          || (userRole() == "admin" && (ownerScope() == null || ownerScope() in ["all", "enzo", "ivo"]))
          || (userRole() == "tenant" && tenantId() != null)
        );
    }

    function isSuperadmin() {
      return hasValidProjectedClaims() && userRole() == "superadmin";
    }

    function isAdmin() {
      return hasValidProjectedClaims() && (userRole() == "admin" || isSuperadmin());
    }

    function isTenant() {
      return hasValidProjectedClaims() && userRole() == "tenant";
    }

    // Storage rules cannot read Firestore `users/{uid}`. These checks use custom
    // claims only as the derived projection written from the canonical profile.
    // Stale broad claims must be corrected by Functions/frontend token refresh.

    match /utility-bills/{billingGroup}/{billId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /payment-receipts/{userId}/{paymentId}/{fileName} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /contracts/{leaseId}/{fileName} {
      allow read, write: if isAdmin();
    }

    match /message-attachments/{messageId}/{fileName} {
      allow read, write: if isAdmin();
    }

    match /rent-receipts/{tenantIdValue}/{receiptId}/{fileName} {
      allow read: if isAdmin() || (isTenant() && tenantId() == tenantIdValue);
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
