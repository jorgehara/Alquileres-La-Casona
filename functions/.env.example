# Copiá este archivo a functions/.env.alquileres-la-casona para desarrollo local.
# No pegues secretos de producción en este ejemplo ni lo reemplaces por valores reales.

# URLs locales usadas por emuladores de Firebase.
WEBAPP_URL=http://127.0.0.1:5000
BACKEND_BASE_URL=http://127.0.0.1:5001/demo-alquileres-la-casona/us-central1

# Integraciones externas: usar credenciales sandbox/locales cuando corresponda.
MERCADO_PAGO_ACCESS_TOKEN=mp_sandbox_access_token_placeholder
MERCADO_PAGO_WEBHOOK_SECRET=mp_webhook_secret_placeholder

# WhatsApp Cloud API (Meta) — https://developers.facebook.com/apps/
WHATSAPP_CLOUD_API_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# SMS fallback (Twilio — opcional)
TWILIO_ACCOUNT_SID=twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=twilio_auth_token_placeholder
TWILIO_SMS_FROM=+5491100000000
SMTP_HOST=smtp.example.test
SMTP_PORT=465
SMTP_USER=smtp_user_placeholder
SMTP_PASS=smtp_password_placeholder
EMAIL_FROM="La Casona Local" <no-reply@example.test>
CLAUDE_API_KEY=anthropic_api_key_placeholder
FINANCIAL_BOT_API_URL=https://financial-bot.example.test/api
FINANCIAL_BOT_API_SECRET=financial_bot_secret_placeholder
